# ==============================================================================
# 涂装车间 DSS (决策支持系统) - 环境变量与参数配置模版
# 复制本文件为 .env 并在本地进行参数调试：cp .env.example .env
# ==============================================================================

# --- 数据库连接（开发/调试可选覆盖，默认直连本地 analytics_db）---
# DSS_DB_HOST=127.0.0.1
# DSS_DB_PORT=5432
# DSS_DB_NAME=analytics_db
# DSS_DB_USER=root
# DSS_DB_PASSWORD=root

# --- 0. Task 1：周计划输入文件夹（目录监听 M3；2026-09-23 用户拍板：项目内新建 plan_inbox/ 为开发默认路径）---
# 生产环境（内网部署机）用本变量覆盖路径，目录约定不变（文件命名 week_plan_YYYYKWww*.csv，见 plan_inbox/README.md）
# DSS_PLAN_FOLDER=plan_inbox

# --- 1. 系统驱动模式（时钟解耦）---
# wall_clock: 现场生产实时墙钟驱动（轮询增量流）
# replay_cursor: 离线历史事件游标驱动（快速回放验证）
DSS_CLOCK_MODE=wall_clock

# 增量轮询周期（秒）：现场默认 300（5分钟）；调试回放可设为 1~5
DSS_POLL_INTERVAL_SEC=300

# --- 2. B3 护栏：数据流健康与新鲜度参数 ---
# 数据陈旧判定阈值（分钟）：无事件超过此时间则判定数据断流并熔断告警（默认 30）
DSS_STALE_MIN=30

# 数据延迟观察态阈值（分钟，默认 15）
DSS_LAG_MIN=15

# （ETL SLA 2026-09-23 拍板：内网生产链路故障由内网数据负责人处理、RTO ≤1h；断流时段预测/预警单独统计、不计入验收门；5 天在线验收在内网生产环境跑）

# 在制池死车判定阈值（小时）：超过此时间无任何事件移出活跃池（默认 120）
DSS_DEAD_VEHICLE_HOURS=120

# 冷启动 bootstrap 回放时长（小时，B4 拍板）：注释/留空 = 默认跟随 DSS_DEAD_VEHICLE_HOURS
# DSS_BOOTSTRAP_HOURS=120

# 主循环周期全量重建间隔（小时，T2.6 F-1 丢行/水位中毒自愈上限）：默认 24
# DSS_REBUILD_HOURS=24

# 增量处理乱序容忍窗口（分钟，默认 15）
DSS_SKEW_WINDOW_MIN=15

# --- 3. Task 3：在线滚动预测与自适应节拍 α ---
# 滑动出站速率统计窗口（小时，默认 3）
DSS_ALPHA_WINDOW_HOURS=3

# 滑动窗口最少出站车辆数（低于此样本数不调整 α，默认 30）
DSS_ALPHA_MIN_SAMPLES=30

# α 平滑因子（EMA Beta，默认 0.3）
DSS_ALPHA_EMA_BETA=0.3

# α 钳制防抖区间 [min, max]
DSS_ALPHA_CLAMP_MIN=0.6
DSS_ALPHA_CLAMP_MAX=1.5

# --- 4. Task 4：缺口预警红黄灯阈值（2026-09-23 用户拍板：按此两条线上线，5 天影子期观察误报率，必要时调整本行）---
# 班次缺口红色紧急警报线（相对于目标的百分比，如 -0.10 代表缺口超过 10%）
DSS_ALERT_RED=-0.10

# 班次缺口黄色预警线（如 -0.05 代表缺口超过 5%）
DSS_ALERT_YELLOW=-0.05

# 告警去抖确认时长（分钟，持续处于该等级才触发，默认 10）
DSS_ALERT_DEBOUNCE_MIN=10

# --- 5. Task 5：停线感知（模式 A）---
# 主干 Backbone 关键站无事件停线触发阈值（分钟，默认 30）
DSS_LINE_STOP_MIN=30

# 观察态阈值（分钟）：关键站无事件达到此时长标记「观察态」（预关注，不发停线告警，默认 15）
DSS_OBSERVE_MIN=15
