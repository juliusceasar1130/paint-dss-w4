__pycache__/
*.pyc
.venv/
venv/
# output/: 内容默认忽略（CSV/调试件），正式报告放行
output/*
!output/*.md
!output/*.json
# W3 5min 高频快照（本地验收留痕，不入库；仅根目录正式报告 *.md/*.json 放行，2026-09-23 复审补）
output/snapshots/
*.log
.DS_Store
Thumbs.db
nul
.pytest_cache/
# .claude/skills 是指向 .agents/skills 的目录联接（junction），单一真相源在 .agents；
# git 会穿透 junction 看到文件，必须忽略，避免同一套技能被重复提交
.claude/skills/
scratch/
# 本地配置与环境变量（敏感参数不入库；.env.example 模版放行）
.env
.env.*
!.env.example
